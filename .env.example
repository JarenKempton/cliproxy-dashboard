# Copy to .env.local (git-ignored) and fill in. Only CPA_MANAGEMENT_KEY is required.

# Plaintext CLIProxyAPI management key (management.secret-key, remote-management.secret-key before v8; before hashing).
CPA_MANAGEMENT_KEY=

# CLIProxyAPI base URL.
CPA_TARGET=http://127.0.0.1:8317

# 1 lets the bridge forward any management write, not just the dashboard's own.
# CPA_ALLOW_WRITES=1

# Dashboard listener. Keep it on loopback: it has no login and acts with the management key.
USAGE_SERVER_HOST=127.0.0.1
USAGE_SERVER_PORT=5174

# Local-network listener for connecting other machines and importing their history. 0 disables it.
LAN_PORT=0

# Tailscale (optional). Machines are named from `tailscale status` when the CLI is found.
# TAILSCALE_BIN=/usr/bin/tailscale
TAILNET_DASHBOARD_PORT=5443
# TAILNET_DASHBOARD_URL=https://dashboard.example.ts.net
# TAILNET_PROXY_URL=https://proxy.example.ts.net

# Storage.
USAGE_DB_PATH=data/usage.db
PRICE_CACHE_PATH=data/litellm-prices.json
DASHBOARD_DIST=dist
