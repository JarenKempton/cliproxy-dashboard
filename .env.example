# Copy to .env.local (git-ignored) and fill in.

# Plaintext management key (the password you use on the built-in panel).
CPA_MANAGEMENT_KEY=

# Where the proxy is running.
CPA_TARGET=http://localhost:8317

# Leave unset to allow only the dashboard's own writes.
# CPA_ALLOW_WRITES=1

# When the dashboard and proxy are on different tailnet machines (deploy/compose.yaml).
# TAILNET_DASHBOARD_URL=https://cliproxy-dashboard.your-tailnet.ts.net
# TAILNET_PROXY_URL=http://your-proxy.your-tailnet.ts.net:8317
