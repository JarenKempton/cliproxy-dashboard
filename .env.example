# Copy to .env.local (git-ignored) and fill in.

# Plaintext management key (the password you use on the built-in panel).
CPA_MANAGEMENT_KEY=

# Where the proxy is running.
CPA_TARGET=http://localhost:8317

# Leave unset to keep the dev bridge read-only.
# CPA_ALLOW_WRITES=1

# Extra hostnames allowed to reach the dev server via a loopback reverse proxy,
# e.g. `tailscale serve --bg --https=5443 http://127.0.0.1:5173` (tailnet-only).
# CPA_ALLOWED_HOSTS=your-mac.your-tailnet.ts.net
