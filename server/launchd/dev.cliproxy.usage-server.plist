<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the usage server at login and restarts it if it exits.
     Install:   cp server/launchd/dev.cliproxy.usage-server.plist ~/Library/LaunchAgents/
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.cliproxy.usage-server.plist
     Uninstall: launchctl bootout gui/$(id -u)/dev.cliproxy.usage-server -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.cliproxy.usage-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jaren/.bun/bin/bun</string>
    <string>server/src/index.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jaren/cliproxy-dashboard</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/jaren/cliproxy-dashboard/data/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jaren/cliproxy-dashboard/data/server.log</string>
</dict>
</plist>
